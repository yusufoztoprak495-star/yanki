  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Yanki.Core\Yanki.Core.csproj" />
  </ItemGroup>

</Project>
