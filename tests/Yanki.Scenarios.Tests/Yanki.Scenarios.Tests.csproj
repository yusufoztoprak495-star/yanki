<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Senaryo testleri: golden replay hash'leri, sıra etkisi testleri, tek seçim farkı (4. haftadan itibaren).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- tr-TR kültüründe aynı diyalog_hash testi gerçek kültür verisi ister (Directory.Build.props InvariantGlobalization=true). -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="CsCheck" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Yanki.Core\Yanki.Core.csproj" />
    <ProjectReference Include="..\..\src\Yanki.Cli\Yanki.Cli.csproj" />
    <ProjectReference Include="..\..\src\Yanki.Dialogue\Yanki.Dialogue.csproj" />
  </ItemGroup>

</Project>
